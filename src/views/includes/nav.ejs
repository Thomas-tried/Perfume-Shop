<% const current = typeof active !== 'undefined' ? active : ''; %>
<header class="site-nav">
  <a class="brand" href="/admin">
    <span class="brand-mark">Perfume Shop</span>
    <span class="brand-sub">Admin</span>
  </a>
  <nav>
    <ul class="nav-links">
      <li><a href="/admin" class="<%= current === 'home' ? 'active' : '' %>">Home</a></li>
      <% if (!member) { %>
      <li><a href="/admin/signup" class="<%= current === 'signup' ? 'active' : '' %>">Signup</a></li>
      <li><a href="/admin/login" class="<%= current === 'login' ? 'active' : '' %>">Login</a></li>
      <% } else { %>
      <li><a href="/admin/product/all" class="<%= current === 'perfumes' ? 'active' : '' %>">Perfumes</a></li>
      <li><a href="/admin/user/all" class="<%= current === 'users' ? 'active' : '' %>">Users</a></li>
      <li><a href="/admin/logout" class="logout-link">Logout</a></li>
      <% } %>
    </ul>
  <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch day / night mode" title="Switch day / night mode">
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
  </nav>
</header>