<%- include('includes/header', { title: 'Home' }) %>
<%- include('includes/nav', { active: 'home' }) %>

<main class="hero">
  <!-- floating scent particles -->
  <div class="scent-field" aria-hidden="true">
    <% for (let i = 0; i < 16; i++) { %>
    <span
      style="--x: <%= (i * 37 + 8) % 100 %>%; --size: <%= 5 + (i * 5) % 9 %>px; --dur: <%= 9 + (i * 7) % 8 %>s; --delay: -<%= (i * 3) % 12 %>s; --drift: <%= (i % 2 === 0 ? 1 : -1) * (14 + (i * 5) % 26) %>px"
    ></span>
    <% } %>
  </div>

  <div class="hero-inner">
    <svg class="hero-bottle" viewBox="0 0 220 170" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <!-- mist sprayed from the nozzle -->
      <g class="mist" stroke="none" fill="currentColor">
        <circle cx="78" cy="14" r="3"   style="--dx: -46px; --dy: -22px; --delay: 0s" />
        <circle cx="78" cy="14" r="2.2" style="--dx: -62px; --dy: -8px;  --delay: .08s" />
        <circle cx="78" cy="14" r="3.4" style="--dx: -54px; --dy: 10px;  --delay: .14s" />
        <circle cx="78" cy="14" r="2"   style="--dx: -78px; --dy: -30px; --delay: .2s" />
        <circle cx="78" cy="14" r="2.6" style="--dx: -70px; --dy: 4px;   --delay: .26s" />
        <circle cx="78" cy="14" r="1.8" style="--dx: -92px; --dy: -14px; --delay: .32s" />
        <circle cx="78" cy="14" r="2.4" style="--dx: -84px; --dy: 18px;  --delay: .38s" />
      </g>

      <!-- bottle -->
      <g class="hero-cap">
        <rect x="96" y="6" width="28" height="22" rx="4" />
        <rect x="84" y="11" width="12" height="6" rx="2" />
      </g>
      <rect x="103" y="28" width="14" height="14" rx="2" />
      <rect class="liquid" x="72" y="96" width="76" height="52" rx="17" fill="currentColor" stroke="none" />
      <rect x="70" y="42" width="80" height="108" rx="20" />
      <rect x="88" y="84" width="44" height="38" rx="5" />
      <path d="M110 92c-7 9-9 13-9 16a9 9 0 0 0 18 0c0-3-2-7-9-16z" />
    </svg>

    <p class="eyebrow rise" style="--i: 1">Admin panel</p>
    <h1 class="hero-title rise" style="--i: 2">Perfume Shop</h1>

    <% if (!member) { %>
    <p class="lead rise" style="--i: 3">Sign in to manage your perfumes and customers.</p>
    <div class="hero-actions rise" style="--i: 4">
      <a class="btn btn-primary" href="/admin/login">Login</a>
      <a class="btn btn-ghost" href="/admin/signup">Signup</a>
    </div>
    <% } else { %>
    <p class="lead rise" style="--i: 3">Welcome back, <%= member.memberNick %>.</p>
    <% } %>
  </div>
</main>

<%- include('includes/footer') %>
