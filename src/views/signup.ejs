<%- include('includes/header', { title: 'Signup' }) %>
<%- include('includes/nav', { active: 'signup' }) %>

<main class="auth-wrap">
  <form
    class="card auth-card auth-card-wide"
    onsubmit="return validateSignupForm()"
    action="/admin/signup"
    method="POST"
    enctype="multipart/form-data"
  >
    <p class="eyebrow">Shop owner</p>
    <h2 class="auth-title">Create your shop account</h2>
    <p class="muted">Only one shop owner account can be created.</p>

    <div class="grid-2">
      <div class="field">
        <label for="memberNick">Shop username *</label>
        <input id="memberNick" type="text" name="memberNick" class="member-nick" placeholder="Username" />
      </div>
      <div class="field">
        <label for="memberPhone">Phone *</label>
        <input id="memberPhone" type="text" name="memberPhone" class="member-phone" placeholder="Phone" />
      </div>
    </div>

    <div class="grid-2">
      <div class="field">
        <label for="memberPassword">Password *</label>
        <input id="memberPassword" type="password" name="memberPassword" class="member-password" placeholder="Password" />
      </div>
      <div class="field">
        <label for="confirmPassword">Repeat password *</label>
        <input id="confirmPassword" type="password" name="confirmPassword" class="confirm-password" placeholder="Repeat password" />
      </div>
    </div>

    <div class="field">
      <label for="memberAddress">Shop address</label>
      <input id="memberAddress" type="text" name="memberAddress" class="member-address" placeholder="Street, city (optional)" />
    </div>

    <div class="field">
      <label>Shop image *</label>
      <label class="avatar-upload" for="input-file">
        <span class="avatar-preview">
          <span class="avatar-plus">+</span>
          <img class="upload-img-frame" alt="" hidden />
        </span>
        <span class="avatar-text">
          <strong>Upload image</strong>
          <small>Only .jpg, .jpeg or .png</small>
        </span>
      </label>
      <input type="file" id="input-file" class="member-image" name="memberImage" accept="image/png, image/jpeg" hidden />
    </div>

    <button class="btn btn-primary btn-block" name="signup" type="submit">Signup</button>

    <p class="auth-foot">
      Already signed up? <a href="/admin/login">Login</a>
    </p>
  </form>
</main>

<script type="text/javascript" src="/js/signup.js"></script>
<%- include('includes/footer') %>
